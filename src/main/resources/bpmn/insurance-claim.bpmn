<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
  PROCESS 3: INSURANCE CLAIM  (Insurance)                 key: insurance-claim
  =============================================================================
  Business story
    A policy holder files a claim. A DMN table lists the documents to upload;
    the process waits (receive task) up to 7 days. Then a separate, reusable
    "fraud-check" process runs (call activity). Depending on amount and injury
    one or more assessments run in parallel (inclusive gateway); three
    adjusters review in parallel and two votes are enough. A Groovy script
    computes the payout and a delegate pays it.

  Concepts covered
    * Receive task + interrupting timer boundary (P7D)
    * DMN COLLECT -> list (mapDecisionResult=collectEntries)
    * Call activity: calledElementBinding, business key propagation, in/out variable mapping
    * ERROR boundary on a call activity (error end event inside the child)
    * Non-interrupting ESCALATION boundary on a call activity
    * Inclusive gateway split + join
    * Parallel multi-instance user task with completionCondition and
      built-in variables nrOfInstances / nrOfActiveInstances / nrOfCompletedInstances
    * Script task (Groovy) with resultVariable
    * Input/output parameter mapping, asyncBefore
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_InsuranceClaim" targetNamespace="http://academy.com/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.40.0"
                  modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="insurance-claim" name="Insurance Claim" isExecutable="true" camunda:historyTimeToLive="P30D" camunda:versionTag="1.0">
    <bpmn:documentation>Claim handling: documents via DMN COLLECT, fraud check in a called process, inclusive assessments, Groovy payout.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_ClaimFiled" name="Claim filed">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="policyNumber" label="Policy number" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="claimType" label="Claim type" type="enum">
            <camunda:value id="MOTOR" name="MOTOR" />
            <camunda:value id="HEALTH" name="HEALTH" />
            <camunda:value id="PROPERTY" name="PROPERTY" />
          </camunda:formField>
          <camunda:formField id="claimAmount" label="Claim amount" type="long">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="hasInjury" label="Injury involved?" type="boolean" />
          <camunda:formField id="daysSincePolicyStart" label="Days since policy start" type="long" />
          <camunda:formField id="previousClaims" label="Previous claims (3 yrs)" type="long" />
          <camunda:formField id="claimantEmail" label="Claimant e-mail" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RegisterClaim" name="Register claim" camunda:delegateExpression="${registerClaimDelegate}">
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_DetermineDocuments" name="Determine required documents" camunda:decisionRef="claim-required-documents" camunda:mapDecisionResult="collectEntries" camunda:resultVariable="requiredDocuments">
      <bpmn:documentation>DMN COLLECT (no aggregator) + collectEntries =&gt; java.util.List&lt;String&gt;.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:receiveTask id="Task_AwaitDocuments" name="Wait for documents" messageRef="Message_ClaimDocumentsUploaded">
      <bpmn:documentation>RECEIVE task: a wait state that is completed by correlating message 'ClaimDocumentsUploaded'.</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_DocumentsTimeout" name="7 days" attachedToRef="Task_AwaitDocuments">
      <bpmn:timerEventDefinition id="TimerDef_Docs">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_CloseIncomplete" name="Close incomplete claim" camunda:class="com.academy.camunda.delegate.common.EmailNotificationDelegate">
      <bpmn:extensionElements>
        <camunda:field name="template">
          <camunda:string>CLAIM_CLOSED_NO_DOCUMENTS</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ClosedIncomplete" name="Closed (no documents)">
    </bpmn:endEvent>
    <bpmn:callActivity id="CallActivity_FraudCheck" name="Fraud check" calledElement="fraud-check" camunda:calledElementBinding="latest">
      <bpmn:documentation>CALL ACTIVITY: starts a separate process instance 'fraud-check' (own definition, own versioning). Only the mapped variables cross the boundary (in/out mappings).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="claimId" target="claimId" />
        <camunda:in source="claimAmount" target="claimAmount" />
        <camunda:in source="daysSincePolicyStart" target="daysSincePolicyStart" />
        <camunda:in source="previousClaims" target="previousClaims" />
        <camunda:out source="fraudScore" target="fraudScore" />
        <camunda:out source="investigationOutcome" target="investigationOutcome" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Boundary_FraudConfirmed" name="Fraud confirmed" attachedToRef="CallActivity_FraudCheck">
      <bpmn:errorEventDefinition id="ErrorDef_Fraud" errorRef="Error_FraudConfirmed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_RejectClaim" name="Reject claim" camunda:delegateExpression="${rejectClaimDelegate}">
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ClaimRejected" name="Claim rejected">
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_FraudSuspected" name="Fraud suspected" attachedToRef="CallActivity_FraudCheck" cancelActivity="false">
      <bpmn:documentation>NON-interrupting ESCALATION boundary: the called process escalates, we inform compliance and continue.</bpmn:documentation>
      <bpmn:escalationEventDefinition id="EscDef_Fraud" escalationRef="Escalation_FraudSuspected" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_NotifyCompliance" name="Notify compliance team" camunda:delegateExpression="${notifyComplianceDelegate}">
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ComplianceInformed" name="Compliance informed">
    </bpmn:endEvent>
    <bpmn:inclusiveGateway id="Gateway_SelectAssessments" name="Which assessments?">
      <bpmn:documentation>INCLUSIVE (OR) gateway: EVERY outgoing flow whose condition is true is activated.</bpmn:documentation>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask_SeniorApproval" name="Senior adjuster approval" camunda:candidateGroups="senior-adjusters">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="claimAmount" label="Claim amount" type="long">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="seniorApproved" label="Approve?" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_MedicalAssessment" name="Medical assessment" camunda:candidateGroups="medical-team">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="medicalNotes" label="Medical notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_AdjusterReview" name="Adjuster review" camunda:assignee="${adjuster}">
      <bpmn:documentation>PARALLEL MULTI-INSTANCE: one task per adjuster in the 'adjusters' list; finishes when 2 of 3 have completed.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="recommendedPayout" label="Recommended payout" type="long" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${adjusters}" camunda:elementVariable="adjuster">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances &gt;= 2}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gateway_JoinAssessments">
      <bpmn:documentation>Inclusive JOIN: waits only for the branches that were actually activated.</bpmn:documentation>
    </bpmn:inclusiveGateway>
    <bpmn:scriptTask id="Task_CalculatePayout" name="Calculate payout" scriptFormat="groovy" camunda:resultVariable="payoutAmount">
      <bpmn:documentation>SCRIPT task (Groovy via JSR-223). Keep scripts tiny; real logic belongs in tested Java code.</bpmn:documentation>
      <bpmn:script><![CDATA[
      // Groovy script task. All process variables are visible as script variables.
      // The value of the last expression becomes "payoutAmount" (camunda:resultVariable).
      def deductible = (claimType == "MOTOR") ? 5000L : 2000L
      Math.max(0L, (claimAmount as Long) - deductible)
      ]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_PayClaim" name="Pay claim" camunda:asyncBefore="true" camunda:delegateExpression="${payClaimDelegate}">
      <bpmn:documentation>INPUT/OUTPUT mapping: the delegate only sees local variables amount/beneficiary/paymentReference; its local result 'paymentStatusLocal' is mapped out as 'paymentStatus'.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="amount">${payoutAmount}</camunda:inputParameter>
          <camunda:inputParameter name="beneficiary">${claimantEmail}</camunda:inputParameter>
          <camunda:inputParameter name="paymentReference">${claimId}-PAY</camunda:inputParameter>
          <camunda:outputParameter name="paymentStatus">${paymentStatusLocal}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ClaimPaid" name="Claim paid">
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ClaimFiled" targetRef="Task_RegisterClaim" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RegisterClaim" targetRef="Task_DetermineDocuments" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DetermineDocuments" targetRef="Task_AwaitDocuments" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AwaitDocuments" targetRef="CallActivity_FraudCheck" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="CallActivity_FraudCheck" targetRef="Gateway_SelectAssessments" />
    <bpmn:sequenceFlow id="Flow_6" name="amount &gt; 1 lakh" sourceRef="Gateway_SelectAssessments" targetRef="UserTask_SeniorApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimAmount &gt; 100000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="injury" sourceRef="Gateway_SelectAssessments" targetRef="UserTask_MedicalAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasInjury}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" name="always" sourceRef="Gateway_SelectAssessments" targetRef="UserTask_AdjusterReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="UserTask_SeniorApproval" targetRef="Gateway_JoinAssessments" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="UserTask_MedicalAssessment" targetRef="Gateway_JoinAssessments" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="UserTask_AdjusterReview" targetRef="Gateway_JoinAssessments" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_JoinAssessments" targetRef="Task_CalculatePayout" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CalculatePayout" targetRef="Task_PayClaim" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PayClaim" targetRef="EndEvent_ClaimPaid" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Boundary_DocumentsTimeout" targetRef="Task_CloseIncomplete" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CloseIncomplete" targetRef="EndEvent_ClosedIncomplete" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Boundary_FraudConfirmed" targetRef="Task_RejectClaim" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RejectClaim" targetRef="EndEvent_ClaimRejected" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Boundary_FraudSuspected" targetRef="Task_NotifyCompliance" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_NotifyCompliance" targetRef="EndEvent_ComplianceInformed" />
  </bpmn:process>
  <bpmn:message id="Message_ClaimDocumentsUploaded" name="ClaimDocumentsUploaded" />
  <bpmn:error id="Error_FraudConfirmed" name="Fraud confirmed" errorCode="FRAUD_CONFIRMED" />
  <bpmn:escalation id="Escalation_FraudSuspected" name="Fraud suspected" escalationCode="FRAUD_SUSPECTED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_insurance-claim">
    <bpmndi:BPMNPlane id="BPMNPlane_insurance-claim" bpmnElement="insurance-claim">
      <bpmndi:BPMNShape id="Shape_StartEvent_ClaimFiled" bpmnElement="StartEvent_ClaimFiled">
        <dc:Bounds x="82" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RegisterClaim" bpmnElement="Task_RegisterClaim">
        <dc:Bounds x="180" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DetermineDocuments" bpmnElement="Task_DetermineDocuments">
        <dc:Bounds x="330" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AwaitDocuments" bpmnElement="Task_AwaitDocuments">
        <dc:Bounds x="480" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CloseIncomplete" bpmnElement="Task_CloseIncomplete">
        <dc:Bounds x="480" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_ClosedIncomplete" bpmnElement="EndEvent_ClosedIncomplete">
        <dc:Bounds x="512" y="522" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CallActivity_FraudCheck" bpmnElement="CallActivity_FraudCheck">
        <dc:Bounds x="640" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RejectClaim" bpmnElement="Task_RejectClaim">
        <dc:Bounds x="620" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_ClaimRejected" bpmnElement="EndEvent_ClaimRejected">
        <dc:Bounds x="792" y="542" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_NotifyCompliance" bpmnElement="Task_NotifyCompliance">
        <dc:Bounds x="640" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_ComplianceInformed" bpmnElement="EndEvent_ComplianceInformed">
        <dc:Bounds x="782" y="42" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_SelectAssessments" bpmnElement="Gateway_SelectAssessments">
        <dc:Bounds x="805" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_SeniorApproval" bpmnElement="UserTask_SeniorApproval">
        <dc:Bounds x="930" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_MedicalAssessment" bpmnElement="UserTask_MedicalAssessment">
        <dc:Bounds x="930" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_AdjusterReview" bpmnElement="UserTask_AdjusterReview">
        <dc:Bounds x="930" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_JoinAssessments" bpmnElement="Gateway_JoinAssessments">
        <dc:Bounds x="1095" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CalculatePayout" bpmnElement="Task_CalculatePayout">
        <dc:Bounds x="1200" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PayClaim" bpmnElement="Task_PayClaim">
        <dc:Bounds x="1350" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_ClaimPaid" bpmnElement="EndEvent_ClaimPaid">
        <dc:Bounds x="1522" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_DocumentsTimeout" bpmnElement="Boundary_DocumentsTimeout">
        <dc:Bounds x="512" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_FraudConfirmed" bpmnElement="Boundary_FraudConfirmed">
        <dc:Bounds x="652" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_FraudSuspected" bpmnElement="Boundary_FraudSuspected">
        <dc:Bounds x="672" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="118" y="260" />
        <di:waypoint x="180" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="280" y="260" />
        <di:waypoint x="330" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="430" y="260" />
        <di:waypoint x="480" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="580" y="260" />
        <di:waypoint x="640" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="740" y="260" />
        <di:waypoint x="805" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="830" y="235" />
        <di:waypoint x="830" y="140" />
        <di:waypoint x="930" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="855" y="260" />
        <di:waypoint x="930" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="830" y="285" />
        <di:waypoint x="830" y="390" />
        <di:waypoint x="930" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1030" y="140" />
        <di:waypoint x="1120" y="140" />
        <di:waypoint x="1120" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1030" y="260" />
        <di:waypoint x="1095" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1030" y="390" />
        <di:waypoint x="1120" y="390" />
        <di:waypoint x="1120" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1145" y="260" />
        <di:waypoint x="1200" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1300" y="260" />
        <di:waypoint x="1350" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="1450" y="260" />
        <di:waypoint x="1522" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_15" bpmnElement="Flow_15">
        <di:waypoint x="530" y="318" />
        <di:waypoint x="530" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_16" bpmnElement="Flow_16">
        <di:waypoint x="530" y="460" />
        <di:waypoint x="530" y="522" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_17" bpmnElement="Flow_17">
        <di:waypoint x="670" y="318" />
        <di:waypoint x="670" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_18" bpmnElement="Flow_18">
        <di:waypoint x="720" y="560" />
        <di:waypoint x="792" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_19" bpmnElement="Flow_19">
        <di:waypoint x="690" y="202" />
        <di:waypoint x="690" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_20" bpmnElement="Flow_20">
        <di:waypoint x="740" y="100" />
        <di:waypoint x="761" y="100" />
        <di:waypoint x="761" y="60" />
        <di:waypoint x="782" y="60" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
